POSTGRES_USER=agent_analyst
POSTGRES_PASSWORD=agent_analyst
POSTGRES_DB=agent_analyst
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
FRONTEND_PORT=8080

SECRET_KEY=dev-secret-key-change-me-32-bytes
ACCESS_TOKEN_TTL_MINUTES=60

# Флаг Secure у cookie сессии. Локально HTTP, поэтому false; в продакшене по HTTPS
# обязательно true — иначе cookie уходит открытым текстом.
COOKIE_SECURE=false

CHECK_TIMEOUT_SECONDS=120
STATE_LIMIT=1000000

# Путь к tla2tools.jar. Внутри образа воркера он лежит в /opt/tla и берётся оттуда;
# локально переменную нужно задать явно — иначе движок не найдёт jar.
TLA_TOOLS_JAR=/opt/tla/tla2tools.jar
TLC_WORKERS=auto
TLA_WORK_DIR=/tmp
ARTIFACTS_DIR=var/artifacts

MINIO_ROOT_USER=agent_analyst
MINIO_ROOT_PASSWORD=agent_analyst
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=agent-analyst-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Провайдер LLM для агента: любой OpenAI-совместимый /chat/completions
# (DeepSeek, OpenRouter, локальный vLLM). Без этих значений агент не строит
# модель и не объясняет контрпримеры, а проверка работает по-прежнему.
LLM_BASE_URL=https://api-ai.mai.ru/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# Таймаут одного запроса: у reasoning-моделей первый ответ после простоя
# готовится дольше, поэтому 180 с вместо типовых 60.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3
# Как просить структурный ответ: json (по умолчанию; json_object + схема
# в запросе), tools или json_schema (только если провайдер это поддерживает).
LLM_STRUCTURED_MODE=json
# Повторы временных отказов провайдера: обрыв соединения, таймаут, 429 или 5xx.
# Пауза удваивается: 0.5 с, 1 с, 2 с.
LLM_TRANSPORT_RETRIES=2
LLM_TRANSPORT_BACKOFF_SECONDS=0.5
# Рассуждения модели: auto — проверить провайдера короткой пробой и показать
# галочку только при поддержке; true/false — задать ответ без пробы.
# LLM_REASONING_EFFORT — усилие, когда пользователь включил рассуждения.
LLM_REASONING_SUPPORTED=auto
LLM_REASONING_EFFORT=high

# Если провайдер подписан корпоративным/национальным CA, контейнеру нужен
# trust store хоста. Оставьте путь по умолчанию для Debian/Ubuntu.
HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
