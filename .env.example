POSTGRES_USER=agent_analyst
POSTGRES_PASSWORD=agent_analyst
POSTGRES_DB=agent_analyst
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
FRONTEND_PORT=8080

SECRET_KEY=dev-secret-key-change-me-32-bytes
ACCESS_TOKEN_TTL_MINUTES=60

# Флаг Secure у cookie сессии. Локально HTTP, поэтому false; в продакшене по HTTPS
# обязательно true — иначе cookie уходит открытым текстом.
COOKIE_SECURE=false

CHECK_TIMEOUT_SECONDS=120
STATE_LIMIT=1000000

MINIO_ROOT_USER=agent_analyst
MINIO_ROOT_PASSWORD=agent_analyst
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=agent-analyst-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001