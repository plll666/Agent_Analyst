# Адрес API. Пустая строка не подходит: клиент всегда ходит в `${VITE_API_BASE_URL}${path}`.
# В dev Vite проксирует /api на http://localhost:8000, в проде nginx — на http://backend:8000.
VITE_API_BASE_URL=/api

# Мок-API для разработки без backend. Включается только в dev-сборке.
# npm run dev       → VITE_USE_MOCKS=false, запросы идут в настоящий backend
# npm run dev:mock  → VITE_USE_MOCKS=true,  запросы обслуживает MSW в памяти
VITE_USE_MOCKS=false